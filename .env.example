# Optional configuration reference; the program does not automatically load this file.
BRIEFMINT_PAYMENT_MODE=mock
BRIEFMINT_ENABLE_MOCK_PAYMENTS=0
BRIEFMINT_ALLOW_REMOTE=0
# Required (32+ characters) for HTTP Alipay modes or remote binding.
BRIEFMINT_API_KEY=

# Configure privately only after merchant authorization and official onboarding.
# Supported modes: alipay-sandbox, alipay-production. No automatic fallback.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_SELLER_NAME=
ALIPAY_SERVICE_ID=
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
# Sandbox uses api_mock_service_id and the fixed official sandbox gateway.
# Production forbids that sandbox ID and uses the fixed production gateway.
